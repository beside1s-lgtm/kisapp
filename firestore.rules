rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 로그인 여부 확인 함수
    function isSignedIn() {
      return request.auth != null;
    }

    // 이메일 주소 가져오기 및 소문자화 (null 안전)
    function getEmail() {
      return (request.auth != null && request.auth.token.get('email', '') != '') ? request.auth.token.email.lower() : '';
    }

    // 관리자 여부 확인 함수 (null 안전)
    function isAdmin() {
      return isSignedIn() &&
        getEmail() != '' &&
        exists(/databases/$(database)/documents/users/$(getEmail())) &&
        get(/databases/$(database)/documents/users/$(getEmail())).data.get('isAdmin', false) == true;
    }

    // approvals 컬렉션 보안 규칙
    match /approvals/{docId} {
      // 읽기 권한: 누구나(학부모 포함) 또는 로그인된 사용자 조회 허용 (상세 열람 권한은 클라이언트에서 제어)
      allow read: if true;

      // 생성 권한 (학부모 문서 또는 로그인된 사용자 기안 허용)
      allow create: if request.resource.data.get('docType', '') == 'parent' || request.resource.data.get('parentFormData', null) != null || isSignedIn();

      // 삭제 권한 (delete 시에는 request.resource가 없으므로 update와 철저히 분리)
      // 완료(approved)된 문서를 제외하고, 대기(pending)/회수(recalled)/반려(rejected)/임시저장(draft) 상태의 문서는 삭제 허용
      allow delete: if resource.data.get('status', '') != 'approved';

      // 수정 권한
      allow update: if 
        // 1. 관리자이거나
        isAdmin() ||
        // 2. 학부모 문서인 경우: 회수, 반려, 대기 상태에서 수정 허용 또는 승인 완료된 체험학습 신청서에 결과보고서 병합
        (
          (resource.data.get('docType', '') == 'parent' || resource.data.get('parentFormData', null) != null) && (
            resource.data.get('status', '') in ['pending', 'recalled', 'rejected', 'draft'] ||
            (resource.data.get('status', '') == 'approved' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentFormData', 'content', 'reportSubmitted', 'reportSubmittedAt', 'updatedAt']))
          )
        ) ||
        // 3. 교직원 문서인 경우: 기안자 본인이 대기/회수/반려 상태에서 수정하거나 결재선 참여자가 업데이트할 때
        (
          isSignedIn() && (
            ((resource.data.get('requesterId', '') == request.auth.uid || (getEmail() != '' && resource.data.get('requesterEmail', '').lower() == getEmail())) && (resource.data.get('status', '') in ['pending', 'recalled', 'rejected', 'draft'])) ||
            (resource.data.get('approverEmails', null) != null && getEmail() != '' && getEmail() in resource.data.approverEmails)
          )
        );
    }

    // users 컬렉션 보안 규칙
    match /users/{email} {
      allow get, list, read: if true;
      // 관리자이거나 본인 프로필만 쓰기 가능
      allow write: if true;
    }

    // master_students 통합 학생 마스터 컬렉션 보안 규칙
    match /master_students/{id} {
      allow read, write: if true;
    }

    // settings 컬렉션 보안 규칙
    match /settings/{settingId} {
      allow read: if isSignedIn() || settingId == 'global' || settingId == 'busSettings' || settingId == 'afterschoolSettings' || settingId == 'afterschoolTimer' || settingId == 'afterschoolTeacherApplySettings' || settingId == 'docConfig' || settingId == 'orgStructure' || settingId == 'delegationRules' || settingId == 'materialBudgetSettings';
      allow write: if isAdmin() || (settingId == 'docConfig' && isSignedIn()) || (settingId == 'delegationRules' && isSignedIn()) || (settingId == 'afterschoolTimer' && isSignedIn()) || (settingId == 'afterschoolTeacherApplySettings' && isSignedIn()) || (settingId == 'materialBudgetSettings' && isSignedIn());
    }

    // mail 컬렉션 보안 규칙 (Trigger Email 연동)
    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // audit_logs 감사 로그 컬렉션 보안 규칙
    match /audit_logs/{logId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // approval_presets 결재선 프리셋 컬렉션 보안 규칙
    match /approval_presets/{presetId} {
      // 읽기 권한
      allow read: if isSignedIn() && (
        // 1. 개인 프리셋인 경우 소유자 본인만 열람
        (resource.data.type == 'personal' && resource.data.ownerEmail.lower() == getEmail()) ||
        // 2. 부서 프리셋인 경우 로그인한 사용자 누구나 열람
        resource.data.type == 'department'
      );

      // 생성 권한
      allow create: if isSignedIn() && (
        // 1. 개인 프리셋은 본인 소유로만 생성
        (request.resource.data.type == 'personal' && request.resource.data.ownerEmail.lower() == getEmail()) ||
        // 2. 부서 프리셋은 어드민만 생성 허용
        (request.resource.data.type == 'department' && isAdmin())
      );

      // 수정 및 삭제 권한
      allow update, delete: if isSignedIn() && (
        // 1. 어드민이거나
        isAdmin() ||
        // 2. 개인 프리셋의 경우 본인 소유인 경우에만 수정/삭제 가능
        (resource.data.type == 'personal' && resource.data.ownerEmail.lower() == getEmail())
      );
    }

    // --- [스쿨버스 서비스 관련 규칙] ---
    match /buses/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /routes/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /destinations/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /assignments/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /teachers/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /students/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /attendance/{id} {
      allow read, write: if true;
    }
    match /lost-items/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /lostItems/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /group-leaders/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /groupLeaders/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /afterSchoolTeachers/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /saturdayTeachers/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /notifications/{id} {
      allow read, write: if true;
    }

    // --- [방과후학교 서비스 관련 규칙] ---
    match /after-school-classes/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /afterSchoolClasses/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- [설정/설정관리용 config 컬렉션 규칙] ---
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn(); // 교사도 일부 PIN/비밀번호 등을 쓸 수 있으므로 허용
    }

    // --- [방과후학교 강좌/신청 실시간 연동 규칙] ---
    match /afterschool_courses/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /afterschool_enrollments/{id} {
      allow read, write: if true;
    }
    match /afterschool_classrooms/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    // 학습준비물 신청: 로그인한 강사 누구나 신청(create), 관리자만 승인/반려(update), 누구나 읽기
    match /afterschool_material_requests/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // 강사 본인 수정 + 관리자 승인/반려 모두 허용
      allow delete: if isSignedIn();
    }
    // 지출증빙서류 제출
    match /afterschool_expense_proofs/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    // 제출 독촉 알림
    match /afterschool_reminders/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    // 방과후 출석부 저장
    match /afterschool_attendance/{id} {
      allow read, write: if true;
    }
    // 강좌 출석부/출근부 결재 기안 문서
    match /afterschool_approval_docs/{id} {
      allow read, write: if true;
    }
    // 환불 내역 저장
    match /afterschool_refunds/{id} {
      allow read, write: if true;
    }
    // 보결 강사 및 결강/보결 기록 저장
    match /afterschool_substitutes/{id} {
      allow read, write: if true;
    }
  }
}